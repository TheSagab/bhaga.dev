---
/**
 * PROTOTYPE — throwaway. Site-wide type switch.
 * Picks the main font for the whole site: ?type=A|B|C, or the floating bar.
 * The choice sticks across navigation (sessionStorage) so long-form pages like
 * a blog post can be judged too. Dev-only: renders nothing in a prod build.
 */
const MODES = [
  { key: "A", label: "Plus Jakarta Sans (baseline)" },
  { key: "B", label: "JetBrains Mono everywhere" },
  { key: "C", label: "Mono headings, Jakarta body" },
];
const isDev = import.meta.env.DEV;
---

{
  isDev && (
    <>
      <script is:inline>
        (() => {
          try {
            const requested = new URLSearchParams(location.search)
              .get("type")
              ?.toUpperCase();
            const stored = sessionStorage.getItem("prototypeFontMode");
            const mode = requested || stored || "A";
            if (["A", "B", "C"].includes(mode)) {
              document.documentElement.dataset.type = mode;
              sessionStorage.setItem("prototypeFontMode", mode);
            }
          } catch (error) {
            /* prototype only */
          }
        })();
      </script>
      <div
        id="font-switcher"
        data-modes={JSON.stringify(MODES)}
        class="fixed bottom-6 left-1/2 z-50 -translate-x-1/2 select-none rounded-full bg-slate-12 px-2 py-1.5 text-sm font-medium text-slate-1 shadow-lg ring-1 ring-slate-8"
        role="group"
        aria-label="Prototype font switcher"
      >
        <div class="flex items-center gap-1">
          <button
            type="button"
            data-dir="-1"
            aria-label="Previous font"
            class="rounded-full px-2.5 py-1 hover:bg-slate-10"
          >
            ←
          </button>
          <span class="min-w-60 px-2 text-center" data-label>
            A
          </span>
          <button
            type="button"
            data-dir="1"
            aria-label="Next font"
            class="rounded-full px-2.5 py-1 hover:bg-slate-10"
          >
            →
          </button>
          <span class="px-2 text-xs uppercase tracking-widest text-slate-9">
            type
          </span>
        </div>
      </div>
    </>
  )
}

<script>
  const el = document.getElementById("font-switcher");
  if (el) {
    const modes: { key: string; label: string }[] = JSON.parse(
      el.dataset.modes ?? "[]"
    );
    const keys = modes.map((mode) => mode.key);
    const label = el.querySelector("[data-label]");
    let current = document.documentElement.dataset.type ?? keys[0];

    function render() {
      const mode = modes.find((m) => m.key === current);
      if (label && mode) label.textContent = `${mode.key} — ${mode.label}`;
    }

    function cycle(dir: number) {
      const index = keys.indexOf(current);
      current = keys[(index + dir + keys.length) % keys.length];
      document.documentElement.dataset.type = current;
      try {
        sessionStorage.setItem("prototypeFontMode", current);
      } catch {
        /* prototype only */
      }
      const url = new URL(window.location.href);
      url.searchParams.set("type", current);
      window.history.replaceState({}, "", url);
      render();
    }

    el.querySelectorAll("[data-dir]").forEach((button) => {
      button.addEventListener("click", () => {
        cycle(Number((button as HTMLElement).dataset.dir));
      });
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (
        target?.closest("input, textarea, select, [contenteditable]") ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey
      ) {
        return;
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        cycle(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        cycle(1);
      }
    });

    render();
  }
</script>

<style is:global>
  /* PROTOTYPE — throwaway type modes. !important only because BaseHead
     declares the body font with a bare `body` selector. */
  :root[data-type="B"],
  :root[data-type="B"] body {
    font-family:
      var(--font-jetbrains-mono), ui-monospace, SFMono-Regular, monospace !important;
  }

  :root[data-type="C"] :is(h1, h2, h3, h4) {
    font-family:
      var(--font-jetbrains-mono), ui-monospace, SFMono-Regular, monospace !important;
  }

  :root:is([data-type="B"], [data-type="C"]) :is(h1, h2, h3, h4) {
    letter-spacing: -0.02em;
  }

  /* Mono advances ~20% wider than Jakarta, so body copy at the same width
     runs to ~95 characters a line. Tighten the prose measure so mode B is
     judged as it would actually be shipped, not as a strawman. */
  :root[data-type="B"] .prose {
    max-width: 68ch;
  }
</style>
