---
/**
 * PROTOTYPE VARIANT C — "Spec rail".
 * Two columns: a monospace key/value rail on the left (name / aka / handle),
 * and the nickname set as the display type on the right with the bio under it.
 * Fact sheet on the left, voice on the right.
 */
import { NAME, NICKNAME, HANDLE, SOCIAL_LINKS } from "../../../consts";
---

<section class="pb-12">
  <div class="grid gap-8 md:grid-cols-[12rem_1fr] md:gap-10">
    <dl class="font-mono text-sm">
      <div class="border-t border-slate-4 py-3">
        <dt class="text-xs uppercase tracking-[0.2em] text-slate-11">name</dt>
        <dd class="pt-1 text-slate-12">{NAME}</dd>
      </div>
      <div class="border-t border-slate-4 py-3">
        <dt class="text-xs uppercase tracking-[0.2em] text-slate-11">aka</dt>
        <dd class="pt-1 text-slate-12">{NICKNAME}</dd>
      </div>
      <div class="border-t border-slate-4 py-3">
        <dt class="text-xs uppercase tracking-[0.2em] text-slate-11">handle</dt>
        <dd class="pt-1">
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-cyan-11 transition-colors hover:text-cyan-12"
          >
            {HANDLE} ↗
          </a>
        </dd>
      </div>
    </dl>

    <div class="md:pt-2">
      <h1 class="text-5xl font-bold tracking-tight text-cyan-12 md:text-6xl">
        {NICKNAME}<span class="sr-only"> — {NAME}</span>
      </h1>
      <p class="max-w-2xl pt-5 text-lg">
        I'm a software engineer from Indonesia, building full-stack applications
        and exploring the intersection of technology and creativity. When I'm
        not coding, you'll find me playing video games, working on side
        projects, or tinkering with random stuff.
      </p>
    </div>
  </div>
</section>
