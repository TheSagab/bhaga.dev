---
/**
 * PROTOTYPE — throwaway. Floating variant switcher for the home page redesign.
 * Renders only in dev (`import.meta.env.DEV`), so it can never ship to users.
 * Cycle with the arrows or the ← / → keys. State lives in the `?variant=` URL param.
 */
interface Props {
  variants: { key: string; label: string }[];
  current: string;
}

const { variants, current } = Astro.props;
const isDev = import.meta.env.DEV;
---

{
  isDev && (
    <div
      id="prototype-switcher"
      data-variants={JSON.stringify(variants)}
      data-current={current}
      class="fixed bottom-6 left-1/2 z-50 -translate-x-1/2 select-none rounded-full bg-slate-12 px-2 py-1.5 text-sm font-medium text-slate-1 shadow-lg ring-1 ring-slate-8"
      role="group"
      aria-label="Prototype variant switcher"
    >
      <div class="flex items-center gap-1">
        <button
          type="button"
          data-dir="-1"
          aria-label="Previous variant"
          class="rounded-full px-2.5 py-1 hover:bg-slate-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-8"
        >
          ←
        </button>
        <span class="min-w-44 px-2 text-center" data-label>
          {current}
        </span>
        <button
          type="button"
          data-dir="1"
          aria-label="Next variant"
          class="rounded-full px-2.5 py-1 hover:bg-slate-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-8"
        >
          →
        </button>
        <span class="px-2 text-xs uppercase tracking-widest text-slate-9">
          prototype
        </span>
      </div>
    </div>
  )
}

<script>
  const el = document.getElementById("prototype-switcher");
  if (el) {
    const variants: { key: string; label: string }[] = JSON.parse(
      el.dataset.variants ?? "[]"
    );
    const panels = Array.from(
      document.querySelectorAll<HTMLElement>("[data-variant-panel]")
    );

    const keys = variants.map((v) => v.key);
    const requested = new URL(window.location.href).searchParams
      .get("variant")
      ?.toUpperCase();
    let current = keys.includes(requested ?? "") ? (requested as string) : keys[0];

    const label = el.querySelector("[data-label]");

    function render() {
      for (const panel of panels) {
        panel.hidden = panel.dataset.variantPanel !== current;
      }
      const variant = variants.find((v) => v.key === current);
      if (label && variant) {
        label.textContent = `${variant.key} — ${variant.label}`;
      }
      const url = new URL(window.location.href);
      url.searchParams.set("variant", current);
      window.history.replaceState({}, "", url);
    }

    function cycle(dir: number) {
      const index = keys.indexOf(current);
      current = keys[(index + dir + keys.length) % keys.length];
      render();
    }

    el.querySelectorAll("[data-dir]").forEach((button) => {
      button.addEventListener("click", () => {
        cycle(Number((button as HTMLElement).dataset.dir));
      });
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (
        target?.closest("input, textarea, select, [contenteditable]") ||
        event.metaKey ||
        event.ctrlKey ||
        event.altKey
      ) {
        return;
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        cycle(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        cycle(1);
      }
    });

    render();
  }
</script>
