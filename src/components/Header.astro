---
import HeaderLink from "./HeaderLink.astro";
import ThemeIcon from "./ThemeIcon.astro";
import { HANDLE } from "../consts";
---

<header class="flex place-content-between place-items-center py-4">
  <div class="font-mono text-xl font-bold"><a href="/" class="hover:text-cyan-11 transition-colors">{HANDLE}</a></div>
  <nav class="flex items-center px-2 font-mono text-sm" aria-label="Primary navigation">
    <HeaderLink href="/blog">Blog</HeaderLink>
    <HeaderLink href="/projects">Projects</HeaderLink>
    <HeaderLink href="/about">About</HeaderLink>
    <HeaderLink href="/uses">Uses</HeaderLink>
  </nav>
  <div>
    <ThemeIcon />
  </div>
</header>
