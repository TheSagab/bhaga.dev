---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import PrototypeSwitcher from "../components/prototype/PrototypeSwitcher.astro";
import HomeVariantA from "../components/prototype/home/HomeVariantA.astro";
import HomeVariantB from "../components/prototype/home/HomeVariantB.astro";
import HomeVariantC from "../components/prototype/home/HomeVariantC.astro";

// PROTOTYPE — home page redesign. Three variants of this route, swapped in the
// browser via ?variant=A|B|C (the switcher also flips them without a reload), so
// the Skills & Technologies and Connect sections can be replaced by recent blog
// posts in whichever shape reads best. Delete the switcher and the losing
// variants once a winner is folded in.

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const VARIANTS = [
  { key: "A", label: "Editorial list" },
  { key: "B", label: "Featured lead" },
  { key: "C", label: "Timeline log" },
];
---

<Layout>
  <div data-variant-panel="A">
    <HomeVariantA posts={allPosts.slice(0, 4)} />
  </div>
  <div data-variant-panel="B" hidden>
    <HomeVariantB posts={allPosts.slice(0, 4)} />
  </div>
  <div data-variant-panel="C" hidden>
    <HomeVariantC posts={allPosts.slice(0, 6)} />
  </div>
  <PrototypeSwitcher variants={VARIANTS} current="A" />
</Layout>
