---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { NAME, NICKNAME, AT_HANDLE, SOCIAL_LINKS } from "../consts";

// Monogram for the intro badge.
const initials = NAME.split(" ")
  .map((word) => word[0])
  .join("");

// Newest first, all of them, grouped by year so the rail reads as a log.
const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const byYear = new Map<string, typeof allPosts>();
for (const post of allPosts) {
  const year = String(post.data.pubDate.getFullYear());
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const years = Array.from(byYear.entries());

// Local YYYY-MM-DD for the monospace rail.
const isoDate = (date: Date) =>
  [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, "0"),
    String(date.getDate()).padStart(2, "0"),
  ].join("-");
---

<Layout>
  <!-- Introduction -->
  <section class="pb-12">
    <div class="flex items-start gap-5">
      <div
        aria-hidden="true"
        class="grid size-16 shrink-0 place-items-center rounded-full bg-cyan-3 font-mono text-xl font-bold text-cyan-11"
      >
        {initials}
      </div>
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-cyan-12 md:text-4xl">
          {NAME}
        </h1>
        <div class="flex flex-wrap items-center gap-3 pt-2 font-mono text-sm">
          <span class="text-slate-11">{NICKNAME}</span>
          <span aria-hidden="true" class="text-slate-8">/</span>
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-cyan-11 transition-colors hover:text-cyan-12"
          >
            {AT_HANDLE}
          </a>
        </div>
      </div>
    </div>
    <p class="max-w-2xl pt-6 text-lg">
      I'm a software engineer from Indonesia, building full-stack applications
      and exploring the intersection of technology and creativity. When I'm not
      coding, you'll find me playing video games, working on side projects, or
      tinkering with random stuff.
    </p>
  </section>

  <!-- All posts, as a dated rail grouped by year -->
  {
    allPosts.length > 0 && (
      <section class="pb-8">
        <div class="flex items-baseline justify-between border-b border-slate-6 pb-3 text-sm">
          <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-11">
            Posts
          </h2>
          <a
            href="/blog"
            class="text-cyan-11 transition-colors hover:text-cyan-12"
          >
            Blog index →
          </a>
        </div>

        {years.map(([year, yearPosts]) => (
          <div class="pt-8">
            <h3 class="pb-3 font-mono text-sm text-slate-11">{year}/</h3>
            <ul>
              {yearPosts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.slug}/`}
                    class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-x-4 border-t border-slate-4 py-4 transition-colors hover:bg-slate-2"
                  >
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="font-mono text-sm text-slate-11"
                    >
                      {isoDate(post.data.pubDate)}
                    </time>
                    <span class="text-lg font-semibold leading-snug transition-colors group-hover:text-cyan-11">
                      {post.data.title}
                    </span>
                    <span class="hidden gap-3 font-mono text-xs text-cyan-11 sm:flex">
                      {post.data.tags?.map((tag) => (
                        <span>#{tag}</span>
                      ))}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }
</Layout>
