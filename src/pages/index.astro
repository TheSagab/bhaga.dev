---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { getCollection } from "astro:content";
import { NAME, NICKNAME, AT_HANDLE, SOCIAL_LINKS } from "../consts";

// Monogram for the intro badge.
const initials = NAME.split(" ")
  .map((word) => word[0])
  .join("");

// Newest first. The home page is a short recent list; the full archive lives
// at /blog.
const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.localeCompare(a.data.pubDate)
);

const HOME_LIMIT = 5;
const recentPosts = allPosts.slice(0, HOME_LIMIT);
---

<Layout>
  <!-- Introduction -->
  <section class="pb-12">
    <div class="flex items-start gap-5">
      <div
        aria-hidden="true"
        class="grid size-16 shrink-0 place-items-center rounded-full bg-cyan-3 font-mono text-xl font-bold text-cyan-11"
      >
        {initials}
      </div>
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-cyan-12 md:text-4xl">
          {NAME}
        </h1>
        <div class="flex flex-wrap items-center gap-3 pt-2 font-mono text-sm">
          <span class="text-slate-11">{NICKNAME}</span>
          <span aria-hidden="true" class="text-slate-8">/</span>
          <a
            href={SOCIAL_LINKS.github}
            target="_blank"
            rel="noopener noreferrer"
            class="text-cyan-11 transition-colors hover:text-cyan-12"
          >
            {AT_HANDLE}
          </a>
        </div>
      </div>
    </div>
    <p class="max-w-[65ch] pt-6 text-lg">
      I'm a software engineer from Indonesia, building full-stack applications
      and exploring the intersection of technology and creativity. When I'm not
      coding, you'll find me playing video games, working on side projects, or
      tinkering with random stuff.
    </p>
  </section>

  <!-- The most recent posts -->
  {
    recentPosts.length > 0 && (
      <section class="pb-8">
        <div class="flex items-baseline justify-between border-b border-slate-6 pb-3 text-sm">
          <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-11">
            Recent posts
          </h2>
          <a
            href="/blog"
            class="text-cyan-11 transition-colors hover:text-cyan-12"
          >
            All posts →
          </a>
        </div>

        <PostList posts={recentPosts} />
      </section>
    )
  }
</Layout>
